{
  "name": "superstudio",
  "version": "0.3.3",
  "description": "AI Productivity Suite - One tool for all your AI work",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/pack-talent.mjs && node scripts/dev.js",
    "build": "node scripts/pack-talent.mjs && electron-vite build",
    "pack:talent": "node scripts/pack-talent.mjs",
    "preview": "electron-vite preview",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dev:dwork": "cross-env FLAVOR=dwork node scripts/dev.js",
    "build:dwork": "cross-env FLAVOR=dwork electron-vite build",
    "dist:dwork:win": "npm run build:dwork && electron-builder --win --config electron-builder.dwork.yml",
    "dist:dwork:mac": "npm run build:dwork && electron-builder --mac --config electron-builder.dwork.yml",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.0.0",
    "@ai-sdk/google": "^1.0.0",
    "@ai-sdk/openai": "^1.0.0",
    "@anthropic-ai/sdk": "^0.96.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@monaco-editor/react": "^4.7.0",
    "@nut-tree-fork/nut-js": "^4.2.6",
    "@tanstack/react-virtual": "^3.13.24",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.0.0",
    "adm-zip": "^0.5.17",
    "ai": "^4.0.0",
    "clsx": "^2.1.1",
    "electron-store": "^8.2.0",
    "lucide-react": "^1.14.0",
    "mammoth": "^1.8.0",
    "monaco-editor": "^0.55.1",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "^4.0.0",
    "playwright-core": "^1.60.0",
    "pptxgenjs": "^3.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-is": "^18.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "sql.js": "^1.12.0",
    "tailwind-merge": "^3.6.0",
    "undici": "^5.29.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^2.0.0",
    "@electron-toolkit/eslint-config-ts": "^2.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@tailwindcss/typography": "^0.5.15",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/sql.js": "^1.4.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^2.3.0",
    "eslint": "^9.0.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.9",
    "yaml": "^2.9.0"
  },
  "build": {
    "appId": "com.superstudio.app",
    "productName": "SuperStudio",
    "copyright": "Copyright © 2025 SuperStudio",
    "npmRebuild": false,
    "publish": [
      {
        "provider": "github",
        "owner": "Leon-OvO",
        "repo": "SuperStudio",
        "releaseType": "release"
      }
    ],
    "directories": {
      "buildResources": "build"
    },
    "electronLanguages": [
      "en-US",
      "zh-CN"
    ],
    "files": [
      "out/**",
      "package.json",
      "!**/.eslintrc.{js,cjs}",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!{.env,.env.*,.npmrc,pnpm-lock.yaml}",
      "!.claude/**",
      "!openspec/**",
      "!scripts/**",
      "!build/**",
      "!dist/**",
      "!node_modules/monaco-editor/**",
      "!node_modules/@monaco-editor/**",
      "!node_modules/lucide-react/**",
      "!node_modules/recharts/**",
      "!node_modules/@xterm/**",
      "!node_modules/@xyflow/**",
      "!node_modules/@reduxjs/**",
      "!node_modules/react-dom/**",
      "!node_modules/react-markdown/**",
      "!node_modules/remark-gfm/**",
      "!node_modules/@tanstack/**",
      "!node_modules/@napi-rs/**",
      "!node_modules/pdfjs-dist/legacy/**",
      "!node_modules/pdfjs-dist/image_decoders/**",
      "!node_modules/pdfjs-dist/web/**",
      "!node_modules/sql.js/dist/sql-asm*",
      "!node_modules/sql.js/dist/worker.sql-asm*",
      "!node_modules/sql.js/dist/*-debug*",
      "!node_modules/sql.js/dist/*-browser*",
      "!node_modules/**/*.map",
      "!node_modules/**/*.d.ts",
      "!node_modules/**/*.d.mts"
    ],
    "asarUnpack": [
      "resources/**",
      "node_modules/sql.js/**",
      "node_modules/node-pty/**",
      "node_modules/@nut-tree-fork/**",
      "node_modules/pdfjs-dist/build/pdf.worker.min.mjs"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "resources/talent-pool.enc",
        "to": "talent-pool.enc"
      }
    ],
    "compression": "maximum",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "${productName}-${version}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
